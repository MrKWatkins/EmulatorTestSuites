<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageProjectUrl>https://mrkwatkins.github.io/EmulatorTestSuites/z80.html</PackageProjectUrl>
        <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    </PropertyGroup>
    <ItemGroup>
        <EmbeddedResource Include="**\*.bin" />
        <EmbeddedResource Include="**\*.rom" />
        <EmbeddedResource Include="**\*.scr" />
        <EmbeddedResource Include="**\*.tap" />
        <EmbeddedResource Include="**\*.z80" />
        <EmbeddedResource Include="Instruction\opcodes.txt" />
        <EmbeddedResource Include="Instruction\DAA\daaoutput.txt" />
        <EmbeddedResource Include="Instruction\Fuse\tests.expected" />
        <EmbeddedResource Include="Instruction\Fuse\tests.in" />
        <EmbeddedResource Include="Instruction\SingleStep\TestCases\*" />
    </ItemGroup>
    <ItemGroup>
        <!-- The Z80N suites hand write their test cases in the Fuse format, and need the internal state types to parse it into. -->
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
            <_Parameter1>MrKWatkins.EmulatorTestSuites.Z80N</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="MrKWatkins.OakAsm.Disassembly" />
        <PackageReference Include="MrKWatkins.OakAsm.Disassembly.Z80" />
        <PackageReference Include="MrKWatkins.OakAsm.Formatting" />
        <PackageReference Include="MrKWatkins.OakAsm.Z80" />
        <PackageReference Include="MrKWatkins.OakIO.ZXSpectrum" />
    </ItemGroup>
    <ItemGroup>
      <ProjectReference Include="..\MrKWatkins.EmulatorTestSuites\MrKWatkins.EmulatorTestSuites.csproj" />
    </ItemGroup>
</Project>
